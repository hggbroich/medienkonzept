{% extends "dashboard/_print.html.twig" %}

{% block title %}{{ fach.bezeichnung }}{% endblock %}

{% block content %}
    {% for group in groups %}

    <table class="table table-striped">
        <colgroup>
            <col class="column-lg">
            <col class="column-md">
            <col class="column-md">
            <col style="width: 35%">
            <col style="width: 35%">
        </colgroup>

        <thead>
        <tr>
            <th scope="col">Modulbezeichnung<br>MKR NRW</th>
            <th scope="col">Stufe und Funktion</th>
            <th scope="col">Umfang</th>
            <th scope="col">Modulbezeichnung</th>
            <th scope="col">Lerneinheitsbezeichnung<br>Werkzeuge</th>
        </tr>
        <tr>
            <th colspan="5" scope="col">{{ group.jahrgangsstufe.bezeichnung }}</th>
        </tr>
        </thead>

        <tbody>
            {% for lerneinheit in group.lerneinheiten %}
                {% for inhalt in lerneinheit.modulInhalte %}
                    <tr>
                        <td>
                            <div class="fw-bold">{{ inhalt.modul.bezeichnung }}</div>

                            <ul>
                                {% for kompetenz in inhalt.kompetenzen %}
                                    <li>{{ kompetenz.kompetenzBereich.laufendeNummer }}.{{ kompetenz.laufendeNummer }} {{ kompetenz.bezeichnung }}</li>
                                {% endfor %}
                            </ul>
                        </td>

                        <td>
                            <div class="fw-bold">{{ inhalt.kompetenzstufe.bezeichnung }}</div>
                            <span>
                                {{ lerneinheit.funktion.bezeichnung }}
                            </span>
                        </td>

                        <td>
                            <div class="fw-bold">
                                {{ 'lerneinheit.stundenumfang'|trans({'%stunden%': lerneinheit.stundenumfang}) }}
                            </div>
                        </td>

                        <td>
                            <div class="fw-bold">{{ inhalt.bezeichnung }}</div>

                            {{ inhalt.zusammenfassung|markdown_to_html }}
                        </td>

                        <td>
                            <div class="fw-bold">{{ lerneinheit.bezeichnung }}</div>
                            <ul>
                                {% for werkzeug in inhalt.werkzeuge %}
                                    <li>{{ werkzeug.bezeichnung }}</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% endfor %}
            {% endfor %}
        </tbody>
    </table>

    {% endfor %}
{% endblock %}