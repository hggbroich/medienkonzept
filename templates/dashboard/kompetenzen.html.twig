{% extends "main.html.twig" %}

{% block title %}{{ 'dashboard.jahrgangsstufe'|trans }}{% endblock %}

{% block content %}
    {% set klassenColumns = [ ['05','06'], ['07','08'], ['09','10'], ['EF', 'Q1', 'Q2'] ] %}
<div class="container-fluid px-0">
    {% for bereich in bereiche %}
        <div class="card">
            <div class="card-header" style="background: {{ bereich.color }}; color: {{ foreground(bereich.color) }}">
                <span>{{ bereich.bezeichnung }}</span>
            </div>

            {% for kompetenz in bereich.kompetenzen %}
                <div class="card-header {% if not loop.first %}border-top{% endif %}">
                    <div class="fw-semibold">{{ bereich.laufendeNummer }}.{{ kompetenz.laufendeNummer }} {{ kompetenz.bezeichnung }}</div>

                    <div class="text-muted">{{ kompetenz.beschreibung }}</div>
                </div>

                <table class="table table-bordered">
                    <colgroup>
                        {% for i in range(1, klassenColumns|length) %}
                            <col style="width: calc(1/{{ klassenColumns|length }} * 100%)">
                        {% endfor %}
                    </colgroup>

                    <thead>
                    <tr>
                        {% for klassen in klassenColumns %}
                            <th>Klasse {{ klassen|enumerate }}</th>
                        {% endfor %}
                    </tr>
                    </thead>

                    <tbody>
                        <tr>
                            {% for klassen in klassenColumns %}
                            <td>
                                {% for lerneinheit in overview.modulInhalte(klassen, kompetenz) %}
                                    <div class="mb-4">
                                        <div>
                                            <span class="fw-bold">
                                                {% if lerneinheit.fach is not null %}{{ lerneinheit.fach }}: {% endif %}
                                            </span>
                                            {{ lerneinheit.bezeichnung }}
                                        </div>

                                        <div>
                                            <ul class="list-unstyled">
                                                {% for inhalt in lerneinheit.modulInhalte %}
                                                    <li>
                                                        <span class="fw-semibold">
                                                        {% for jgst in lerneinheit.jahrgangsstufen %}
                                                            {{ jgst }}{% if not loop.last %}, {% endif %}
                                                        {% endfor %}
                                                        </span>

                                                        <a href="{{ path('show_modulinhalt', { id: inhalt.id }) }}">{{ inhalt.bezeichnung }}</a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    </div>
                                {% endfor %}
                            </td>
                            {% endfor %}
                        </tr>
                    </tbody>
                </table>
            {% endfor %}
        </div>
    {% endfor %}
</div>
{% endblock %}